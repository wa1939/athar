# Auto-detect text files, normalize line endings to LF
* text=auto eol=lf

# Force LF for shell + Gradle wrapper + Kotlin
*.sh text eol=lf
gradlew text eol=lf
*.kt text eol=lf
*.kts text eol=lf

# Force CRLF for Windows batch
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.otf binary
*.ttf binary
*.woff2 binary
*.jar binary
*.apk binary
*.aar binary
*.keystore binary
*.jks binary
*.athar binary
*.tflite binary
*.xlsx binary
*.pdf binary

# Linguist hints — keep Kotlin as the detected language, hide vendored content
docs/branding/*.png linguist-vendored
"thmanyah typeface/**" linguist-vendored
